## Copy or rename this file to .env next to docker-compose.yml

# Required bot token
BOT_TOKEN=123456:ABCDEF_your_bot_token_here

# PostgreSQL connection string. The default matches docker-compose.yml.
POSTGRES_CONNECTION_STRING=Host=postgres;Port=5432;Database=pills;Username=pills;Password=pills;Pooling=true;Maximum Pool Size=20

# Sticker set names, comma-separated, without https://t.me/addstickers/
# Example: tenerezze1,kitties4bynorufx_by_fStikBot
STICKER_SETS=tenerezze1,kitties4bynorufx_by_fStikBot

# Optional scheduler tuning.
# Defaults in the app: check due reminders every 60 seconds; repeat unacknowledged reminders every 120 minutes.
# SCHEDULER_POLL_SECONDS=60
# REPEAT_UNTIL_ACK_MINUTES=120

# Optional container user id. Default is 0.
# APP_UID=0
